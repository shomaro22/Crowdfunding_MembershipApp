# Backend API origin (no trailing slash).
# Local Vite dev: http://localhost:8080
# Vercel + Render: https://crowdfunding-membershipapp.onrender.com
VITE_API_BASE_URL=http://localhost:8080

# Stripe 公開鍵（Vercel 本番必須 — 未設定だと決済ができない）
# Render の STRIPE_SECRET_KEY と同じ Stripe アカウントの pk_test_... / pk_live_...
VITE_STRIPE_PUBLISHABLE_KEY=
