DATABASE_URL=postgres://postgres:postgres@localhost:5432/crowdfund?sslmode=disable
REDIS_ADDR=localhost:6379
PORT=8080
PUBLIC_ROOT=backend/data/public
PRIVATE_ROOT=backend/data/private
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth secrets (each at least 32 characters; use distinct values in production)
JWT_SECRET=change-me-jwt-secret-min-32-chars!!
TOTP_ENCRYPTION_KEY=change-me-totp-encryption-key-32!!
KYC_SIGNING_KEY=change-me-kyc-signing-key-min-32!!
PENDING_2FA_KEY=change-me-pending-2fa-key-min-32!!

API_PUBLIC_URL=http://localhost:8080
PUBLIC_APP_URL=http://localhost:5173
TOTP_ISSUER=CrowdfundApp
COOKIE_SECURE=false

# Docker compose seed (backend-seed service)
TEST_USER_PASSWORD=password123
SEED_TEST_USER_TEAM=1
# SEED_TEST_USER_RESET=1

# Stripe (未設定時は決済機能を無効化して起動)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_CONNECT_RETURN_URL=http://localhost:5173/seller/connect/return
# STRIPE_CONNECT_REFRESH_URL=http://localhost:5173/seller/connect/refresh
